    "harvester_attacked": "{name} under attack",
    "hazard_sighted": "Hazard sighted",
    "storage_full": "Storage full: build silos",
    "repairing": "Repairing {name}",
    "repaired": "{name} repaired",
    "building_sold": "{name} sold",
    "building_captured": "{name} captured",
